        <mxCell id="p4-20" value="&lt;span style=&quot;font-size:16px;color:#59636B&quot;&gt;UC-25&lt;/span&gt;&lt;br/&gt;Blokir / buka blokir&lt;br/&gt;akun pemilik" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#202A31;strokeWidth=1.8;fontFamily=Arial;fontSize=22;spacing=8;" vertex="1" parent="1">
