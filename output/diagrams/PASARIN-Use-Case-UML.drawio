        <mxCell id="p3-28" value="&lt;b&gt;Identitas pemilik&lt;/b&gt;&lt;br/&gt;KTP wajib; NIB opsional.&lt;br/&gt;Identitas diajukan sekali&lt;br/&gt;per akun pemilik. Toko lain&lt;br/&gt;memakai identitas yang sama." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
