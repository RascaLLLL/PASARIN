            <mxPoint x="1110" y="550" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3-30" value="&lt;b&gt;Publikasi langsung&lt;/b&gt;&lt;br/&gt;Toko dan produk dapat tayang&lt;br/&gt;setelah data wajib lengkap.&lt;br/&gt;Persetujuan admin bukan&lt;br/&gt;prasyarat publikasi." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="930" y="835" width="355" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p3-31" value="&lt;b&gt;Kepemilikan toko&lt;/b&gt;&lt;br/&gt;Satu akun dapat memiliki&lt;br/&gt;beberapa toko. Produk dan&lt;br/&gt;dashboard mengikuti toko&lt;br/&gt;yang sedang dikelola." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="930" y="1120" width="355" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p3-32" value="&lt;b&gt;Prasyarat akses&lt;/b&gt;&lt;br/&gt;Sesi pemilik aktif.&lt;br/&gt;Akun tidak diblokir.&lt;br/&gt;Hanya mengelola toko sendiri." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="930" y="1410" width="355" height="177" as="geometry" />
        </mxCell>
        <mxCell id="p3-33" value="UC-16 dirinci menjadi tambah, ubah, dan hapus. NIB opsional dicatat sebagai aturan dokumen." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#59636B;fontStyle=0;" vertex="1" parent="1">
