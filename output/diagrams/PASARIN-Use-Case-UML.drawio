        </mxCell>
        <mxCell id="p4-21" value="&lt;b&gt;Verifikasi identitas&lt;/b&gt;&lt;br/&gt;Pemeriksaan sekali per akun.&lt;br/&gt;Setujui atau minta perbaikan&lt;br/&gt;beserta alasan. Publikasi&lt;br/&gt;toko berjalan terpisah." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="980" y="420" width="330" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p4-22" value="&lt;b&gt;Moderasi setelah tayang&lt;/b&gt;&lt;br/&gt;Tinjau laporan produk, toko,&lt;br/&gt;atau ulasan. Pertahankan,&lt;br/&gt;sembunyikan, atau tampilkan&lt;br/&gt;kembali konten dengan&lt;br/&gt;alasan keputusan." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="980" y="725" width="330" height="233" as="geometry" />
        </mxCell>
        <mxCell id="p4-23" value="&lt;b&gt;Kelola toko dan produk&lt;/b&gt;&lt;br/&gt;Toko: ubah data, aktifkan,&lt;br/&gt;atau nonaktifkan.&lt;br/&gt;Produk: ubah data,&lt;br/&gt;sembunyikan / tampilkan." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="980" y="1060" width="330" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p4-24" value="&lt;b&gt;Pemblokiran pemilik&lt;/b&gt;&lt;br/&gt;Blokir berlaku pada seluruh&lt;br/&gt;toko dan produk pemilik.&lt;br/&gt;Alasan wajib dicatat.&lt;br/&gt;Admin dapat membuka blokir." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="980" y="1370" width="330" height="205" as="geometry" />
        </mxCell>
        <mxCell id="p4-25" value="Prasyarat: sesi admin aktif. Akun admin disediakan&lt;br/&gt;sistem; bukan melalui pendaftaran publik." style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFFFFF;strokeColor=#59636B;strokeWidth=1.3;fontFamily=Arial;fontSize=19;align=left;verticalAlign=top;spacing=15;" vertex="1" parent="1">
          <mxGeometry x="410" y="1800" width="550" height="115" as="geometry" />
        </mxCell>
        <mxCell id="p4-26" value="UC-24 dirinci menjadi kelola toko dan kelola produk. Pemeriksaan konten tidak menahan publikasi awal." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Arial;fontSize=19;fontColor=#59636B;fontStyle=0;" vertex="1" parent="1">
